// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model StravaToken {
  id            String   @id @default(uuid())
  userId        String?  @unique
  accessToken   String
  refreshToken  String
  expiresAt     DateTime
  tokenType     String   @default("Bearer")
  scope         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("strava_tokens")
}

model Activity {
  id                    String    @id @default(uuid())
  stravaId              BigInt    @unique
  name                  String?
  distance              Float?    @default(0)
  elapsedTime           Int?      @default(0)
  totalElevationGain    Float?    @default(0)
  averageHeartRate      Int?
  calories              Int?
  averageSpeed          Float?
  type                  String?
  startDate             DateTime?
  startDateLocal        DateTime?
  splitsStandard        Json?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("activities")
  @@index([stravaId])
  @@index([startDate])
  @@index([type])
}

model TrainingBlock {
  id              String   @id @default(uuid())
  raceName        String
  identifier      String
  raceDate        DateTime
  startDate       DateTime
  durationWeeks   Int
  goalTime        String?
  goalDescription String?
  locked          Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  plannedWorkouts PlannedWorkout[]
  trainingWeeks   TrainingWeek[]

  @@map("training_blocks")
  @@index([raceDate])
  @@index([startDate])
}

enum PlannedWorkoutType {
  easy
  workout
  long
}

model TrainingWeek {
  id              String   @id @default(uuid())
  trainingBlockId String
  weekNumber      Int
  story           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  trainingBlock TrainingBlock @relation(fields: [trainingBlockId], references: [id], onDelete: Cascade)

  @@unique([trainingBlockId, weekNumber])
  @@index([trainingBlockId])
  @@map("training_weeks")
}

model PlannedWorkout {
  id                   String              @id @default(uuid())
  trainingBlockId      String
  weekNumber           Int
  dayCode              String
  scheduledDate        DateTime
  plannedMiles         Float?
  workoutType          PlannedWorkoutType?
  sortOrder            Int
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  trainingBlock TrainingBlock @relation(fields: [trainingBlockId], references: [id], onDelete: Cascade)

  @@unique([trainingBlockId, weekNumber, dayCode])
  @@index([trainingBlockId])
  @@index([scheduledDate])
  @@map("planned_workouts")
}
